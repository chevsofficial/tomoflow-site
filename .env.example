# TomoFlow env — set these in the Vercel project (never commit real values).
# The static client reads Payment Link / BTC from assets/js/config.js.
# Server routes under /api/* read the secrets below.

# --- Stripe (Vercel Marketplace sandbox for test; swap to live keys to go live) ---
# Secret key from Stripe Dashboard or Vercel Stripe integration (sk_test_… / sk_live_…)
STRIPE_SECRET_KEY=

# Webhook signing secret for /api/stripe-webhook (whsec_…)
STRIPE_WEBHOOK_SECRET=

# Optional: paste the same Payment Link URL here for docs / future injection.
# Client currently uses assets/js/config.js → stripePaymentLink.
# STRIPE_PAYMENT_LINK=https://buy.stripe.com/REPLACE

# TomoFlow Pro identifiers (required for Restore to ignore other products on the same Stripe account).
# From Stripe Dashboard / Payment Link creation (sandbox values shown as examples):
STRIPE_PRO_PRODUCT_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_PAYMENT_LINK_ID=

# --- Resend (purchase confirmations and restore emails) ---
RESEND_API_KEY=
# e.g. TomoFlow <noreply@tomoflow.app>  (must be a verified Resend domain)
RESEND_FROM=TomoFlow <noreply@tomoflow.app>

# --- Restore behavior ---
# When Resend is not configured, set to 1 in Preview/sandbox only so
# /api/restore-pro can return { unlocked: true } after Stripe confirms a paid purchase.
# Never enable on production without understanding the risk.
ALLOW_CLIENT_RESTORE=0

# Canonical site URL used in restore emails (no trailing slash).
PUBLIC_SITE_URL=https://www.tomoflow.app

# Optional tip address note (client still uses config.js):
# BTC_TIP_ADDRESS=bc1...

# Durable purchase-confirmation outbox (server-only Supabase Data API).
SUPABASE_URL=
# Modern sb_secret_ key preferred; legacy service_role JWT is also supported.
# Never use a publishable/anon key or put this in client-side configuration.
SUPABASE_SECRET_KEY=
