# Optional documentation only — the simplified static site reads
# assets/js/config.js (not server env) for client placeholders.
#
# When you create a Stripe Payment Link:
#   Amount: $21.00 USD (one-time)
#   After payment → redirect to: https://YOUR_DOMAIN/?pro=1
#
# Then set in assets/js/config.js:
#   stripePaymentLink: "https://buy.stripe.com/..."
#   btcAddress: "bc1..."
#
# STRIPE_PAYMENT_LINK=https://buy.stripe.com/REPLACE
# BTC_TIP_ADDRESS=REPLACE_WITH_BTC_ADDRESS
