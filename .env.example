# Server-only Vercel settings. Keep Stripe in sandbox.
# The static client reads only assets/js/config.js (no secrets).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Configure at least one exact sandbox Pro identifier.
STRIPE_PRO_PRODUCT_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_PAYMENT_LINK_ID=

# Verified transactional email configuration.
RESEND_API_KEY=
RESEND_FROM=TomoFlow <noreply@tomoflow.app>
PUBLIC_SITE_URL=https://www.tomoflow.app

# Dedicated server-only email outbox; do not reuse the older Supabase project.
TOMOFLOW_SUPABASE_URL=
# Modern sb_secret_ key preferred; legacy service_role JWT is supported.
TOMOFLOW_SUPABASE_SECRET_KEY=
